# Copy to .env.local for development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# Public site URL (no trailing slash). On Vercel it falls back to the production domain if unset.
NEXT_PUBLIC_SITE_URL=https://www.example.ca

# WhatsApp Business number: country code + number, digits only (Canada = 1 + 10 digits).
# Defaults to the client number in content/site.ts; set only to override.
NEXT_PUBLIC_WHATSAPP_NUMBER=16478020251

# Optional contact details shown on the site and in Google structured data (hidden when empty).
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Quote form email delivery via Resend (https://resend.com).
RESEND_API_KEY=
# Inbox(es) that receive quote requests; comma-separate multiple addresses.
QUOTE_TO_EMAIL=
# Sender address on a domain verified in Resend. Until then, leave empty to use onboarding@resend.dev.
QUOTE_FROM_EMAIL=
